# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
IN_MEMORY_CACHE_MAX_ENTRIES=1000

# ── PostgreSQL (AI Intelligence Database) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kratos_ai
POSTGRES_USER=kratos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_SSL=false

# Connection pool tuning (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEYS=KEY1,KEY2,KEY3
GEMINI_FLASH_MODEL=models/gemini-2.5-flash
GEMINI_PRO_MODEL=models/gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Rate Limiting & Caching ──────────────────────────────────────────────────
GEMINI_RPM_LIMIT=60
GEMINI_TPM_LIMIT=1000000
USER_RPM_LIMIT=20
AI_CACHE_TTL_SECONDS=86400
GEMINI_STREAM_MAX_OUTPUT_TOKENS=512
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_CONTEXT_MAX_MESSAGES=20
MAX_IMAGE_UPLOAD_BYTES=5242880

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
DEBUG=false

# ── Security & Auth ───────────────────────────────────────────────────────────
# Path to your Firebase service account JSON key (keep this file out of git!)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Azure Container Apps: store the entire service-account JSON in the
# FIREBASE_SERVICE_ACCOUNT_JSON secret instead of copying a credentials file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use Application Default Credentials on GCP:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production, set to your actual Flutter/web app origins.
# For local dev:        ALLOWED_ORIGINS=[]
# For production web:   ALLOWED_ORIGINS=["https://your-app.example.com"]
ALLOWED_ORIGINS=[]
