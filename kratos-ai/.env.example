# ── Application ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL (AI Intelligence Database) ────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kratos_ai
POSTGRES_USER=kratos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Connection pool tuning (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_API_KEYS=KEY1,KEY2,KEY3
GEMINI_FLASH_MODEL=models/gemini-2.5-flash
GEMINI_PRO_MODEL=models/gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Rate Limiting & Caching ──────────────────────────────────────────────────
GEMINI_RPM_LIMIT=60
GEMINI_TPM_LIMIT=1000000
USER_RPM_LIMIT=20
AI_CACHE_TTL_SECONDS=86400

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
DEBUG=false

# ── Security & Auth ───────────────────────────────────────────────────────────
# Path to your Firebase service account JSON key (keep this file out of git!)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Or use Application Default Credentials on GCP:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production, set to your actual Flutter/web app origins.
# For local dev:        ALLOWED_ORIGINS=["*"]
# For production:       ALLOWED_ORIGINS=["https://your-app.example.com"]
ALLOWED_ORIGINS=["*"]
